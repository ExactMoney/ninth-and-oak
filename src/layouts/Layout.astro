---
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#202326" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/brand-mark.svg" />
    <link rel="shortcut icon" href="/brand-mark.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ninth & Oak" />
    <meta property="og:image" content="https://ninthandoak.com/social-mark.png" />
    <meta property="og:image:alt" content="Ninth &amp; Oak 9 and leaf mark" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content="https://ninthandoak.com/social-mark.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
