---
import Layout from '../layouts/Layout.astro';

const services = [
  { n: '01', title: 'AI Consulting', text: 'Practical AI strategy built around how your business works.' },
  { n: '02', title: 'Business Automation', text: 'Connected systems that reduce busywork and return time.' },
  { n: '03', title: 'Website Development', text: 'Fast, refined experiences that turn attention into action.' },
  { n: '04', title: 'Digital Marketing', text: 'Focused campaigns that earn attention and durable growth.' },
  { n: '05', title: 'Strategic Consulting', text: 'Clear guidance for pivotal decisions and meaningful progress.' },
];

const reasons = [
  ['Business first', 'Technology is only useful when it advances a real objective. Every recommendation begins with the outcome.'],
  ['Built to last', 'We favor clear architecture, documented decisions, and systems your team can confidently own.'],
  ['One connected view', 'Strategy, brand, operations, and technology work together—so our thinking does, too.'],
];
---
<Layout title="Ninth & Oak | Business, AI & Digital Consulting" description="Ninth & Oak helps established businesses move forward with AI consulting, automation, web development, digital marketing, and strategic guidance.">
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header" data-header>
    <a class="brand" href="#top" aria-label="Ninth and Oak home">
      <img src="/images/ninth-and-oak-logo-transparent.png" alt="Ninth & Oak" width="2048" height="768" />
    </a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="nav"><span></span><span></span><span class="sr-only">Menu</span></button>
    <nav id="nav" aria-label="Primary navigation">
      <a href="#story">About us</a><a href="#services">Services</a><a href="#approach">Approach</a><a href="#contact">Contact</a>
    </nav>
    <a class="header-cta" href="#contact">Schedule a consultation <span class="arrow-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6"/></svg></span></a>
  </header>

  <main id="main">
    <section class="hero" id="top">
      <div class="line-field parallax" data-speed="-.035" aria-hidden="true"><i></i><i></i><i></i><i></i><b>IX</b></div>
      <div class="hero-copy reveal">
        <p class="eyebrow"><span></span> Independent business consultancy</p>
        <h1>Rooted in Experience.<br /><em>Built for What’s Next.</em></h1>
        <p class="lede">We help ambitious businesses turn complex challenges into clear, practical progress—across strategy, technology, and growth.</p>
        <div class="hero-actions"><a class="button copper" href="#contact">Schedule a Consultation <span class="arrow-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6"/></svg></span></a><a class="text-link" href="#services">Explore our services <span class="down-icon" aria-hidden="true"></span></a></div>
      </div>
      <div class="hero-note"><span class="line"></span><p>Deep roots.<br />Forward thinking.</p></div>
      <div class="scroll" aria-hidden="true">Scroll to explore <span>↓</span></div>
    </section>

    <section class="intro band">
      <p class="section-tag">What we do</p>
      <p class="statement reveal">The strongest businesses know where they come from—and where they’re going. <em>We help bridge the two.</em></p>
    </section>

    <section class="story" id="story">
      <div class="story-lines parallax" data-speed=".025" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="story-title reveal">
        <p class="eyebrow"><span></span> About us</p>
        <h2>Family at the Center.<br />Driven by Purpose.<br /><em>Built for What’s Next.</em></h2>
        <figure class="family-portrait reveal"><span aria-hidden="true"></span><img src="/images/ninth-and-oak-family-transparent.png" alt="The Ninth & Oak family" width="1468" height="1072" loading="lazy" /></figure>
      </div>
      <div class="story-copy reveal">
        <p class="story-lead">A name inspired by second chances, enduring roots, and building something meaningful together.</p>
        <div class="story-columns">
          <div><h3>Ninth</h3><p>The ninth inning reminds us there is always time to step up, make an impact, and finish strong.</p></div>
          <div><h3>Oak</h3><p>Oak reflects family, stability, Kentucky heritage, and the strength created when different paths grow together.</p></div>
        </div>
        <details class="full-story"><summary>Read our full story <span class="plus" aria-hidden="true"></span></summary><div><p>Together, Ninth & Oak reflects our belief that experience shapes us, second chances strengthen us, and the most meaningful things in life are built with intention.</p><p>We bring that same philosophy to business—combining practical experience, innovative technology, and genuine relationships to help organizations grow, adapt, and build lasting success.</p></div></details>
        <p class="story-signoff">Ninth & Oak. <em>Rooted in Experience. Built for What’s Next.</em></p>
      </div>
    </section>

    <section class="services wrap" id="services">
      <div class="section-heading reveal"><div><p class="eyebrow"><span></span> Our expertise</p><h2>Clarity at every<br /><em>turning point.</em></h2></div><p>From the first strategic question to the final implementation, we bring the perspective and practical capability to move good businesses forward.</p></div>
      <div class="service-list">
        {services.map((service) => <article class="service reveal"><span>{service.n}</span><h3>{service.title}</h3><p>{service.text}</p><i class="arrow-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6"/></svg></i></article>)}
      </div>
    </section>

    <section class="why" id="why">
      <figure class="oak-panel"><img src="/images/oak-canopy-unsplash.jpg" alt="Sunlight filtering through the branches of a mature oak tree" width="2200" height="1467" loading="lazy" /><div class="branch-lines parallax" data-speed=".025" aria-hidden="true"><i></i><i></i><i></i><i></i></div><p aria-hidden="true">9<span>+</span></p><figcaption>Photo by Leticia Golubov / Unsplash</figcaption></figure>
      <div class="why-copy reveal">
        <p class="eyebrow light"><span></span> Why Ninth & Oak</p>
        <h2>Steady judgment.<br /><em>Modern momentum.</em></h2>
        <p class="why-lede">You don’t need more noise. You need a partner who can see the whole picture, ask the right questions, and help you make the next move with confidence.</p>
        <div class="reasons">{reasons.map(([title, text], i) => <div><b>0{i + 1}</b><h3>{title}</h3><p>{text}</p></div>)}</div>
      </div>
    </section>

    <section class="approach wrap" id="approach">
      <div class="approach-head reveal"><p class="eyebrow"><span></span> Our approach</p><h2>Measured by progress,<br /><em>not presentations.</em></h2><figure class="approach-image"><img src="/images/wood-staircase-unsplash.jpg" alt="Sculptural oak staircase illuminated by warm architectural lighting" width="2200" height="1467" loading="lazy" /><span aria-hidden="true"></span><figcaption>Photo by Declan Sun / Unsplash</figcaption></figure></div>
      <ol>
        <li class="reveal"><span>01</span><div><h3>Listen deeply</h3><p>We begin with your goals, your constraints, and the context only you know.</p></div></li>
        <li class="reveal"><span>02</span><div><h3>Find the signal</h3><p>We turn complexity into a focused plan with priorities, owners, and practical next steps.</p></div></li>
        <li class="reveal"><span>03</span><div><h3>Build with purpose</h3><p>We implement thoughtfully, communicate clearly, and make sure the work earns its place.</p></div></li>
        <li class="reveal"><span>04</span><div><h3>Strengthen what works</h3><p>We measure, learn, and refine—creating capability that compounds over time.</p></div></li>
      </ol>
    </section>

    <section class="contact" id="contact">
      <div class="contact-intro reveal"><p class="eyebrow light"><span></span> Start a conversation</p><h2>What’s the next<br /><em>chapter?</em></h2><p>Tell us where you’re headed—or what’s standing in the way. We’ll start with a thoughtful conversation.</p><a href="mailto:hello@ninthandoak.com">hello@ninthandoak.com <span class="arrow-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6"/></svg></span></a></div>
      <form class="lead-form" name="consultation" method="POST" action="/thank-you" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="consultation" /><p class="hidden"><label>Don’t fill this out: <input name="bot-field" /></label></p>
        <div class="field"><label for="name">Name</label><input id="name" name="name" type="text" autocomplete="name" required placeholder="Your name" /></div>
        <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required placeholder="you@company.com" /></div>
        <div class="field"><label for="company">Company <span>Optional</span></label><input id="company" name="company" type="text" autocomplete="organization" placeholder="Company name" /></div>
        <div class="field"><label for="service">What can we help with?</label><select id="service" name="service" required><option value="" disabled selected>Select a service</option>{services.map((s) => <option value={s.title}>{s.title}</option>)}<option value="Not sure yet">Not sure yet</option></select></div>
        <div class="field full"><label for="message">Tell us a little about your goals</label><textarea id="message" name="message" rows="4" required placeholder="What would you like to accomplish?"></textarea></div>
        <button class="button copper" type="submit">Send inquiry <span class="arrow-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6"/></svg></span></button><p class="privacy">By submitting, you agree to be contacted about your inquiry. No spam—ever.</p>
      </form>
    </section>
  </main>

  <footer><div class="footer-lockup"><a class="footer-brand" href="#top"><img src="/images/ninth-and-oak-logo-transparent.png" alt="Ninth & Oak" /></a><p>Rooted in Experience.<br />Built for What’s Next.</p></div><div class="footer-nav"><a href="#story">About us</a><a href="#services">Services</a><a href="#approach">Approach</a><a href="#contact">Contact</a></div><small>© {new Date().getFullYear()} Ninth & Oak. All rights reserved.</small><a class="top" href="#top">Back to top ↑</a></footer>

  <script>
    const menu = document.querySelector('.menu');
    const nav = document.querySelector('#nav');
    menu?.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') === 'true'; menu.setAttribute('aria-expanded', String(!open)); nav?.classList.toggle('open', !open); });
    nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { menu?.setAttribute('aria-expanded', 'false'); nav.classList.remove('open'); }));
    const observer = new IntersectionObserver(entries => entries.forEach(entry => entry.isIntersecting && entry.target.classList.add('visible')), { threshold: .12 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    const movers = [...document.querySelectorAll<HTMLElement>('.parallax')];
    let ticking = false;
    const move = () => { movers.forEach(el => { const speed = Number(el.dataset.speed || 0); const box = el.parentElement?.getBoundingClientRect(); if (box) el.style.setProperty('--drift', `${(box.top + box.height / 2 - innerHeight / 2) * speed}px`); }); ticking = false; };
    addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(move); ticking = true; } }, { passive: true });
    move();
  </script>
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap');
  :root{--ink:#202326;--copper:#b76e43;--copper-dark:#9a5733;--cream:#f4efe6;--paper:#fbf8f2;--sage:#74796d;--line:rgba(32,35,38,.16);--serif:'Libre Caslon Display',Georgia,serif;--sans:'DM Sans',Arial,sans-serif}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.6}a{color:inherit}.skip{position:fixed;z-index:100;top:8px;left:8px;background:white;padding:.6rem 1rem;transform:translateY(-140%)}.skip:focus{transform:none}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
  .site-header{height:104px;display:flex;align-items:center;padding:0 clamp(1.25rem,5vw,5rem);position:absolute;inset:0 0 auto;z-index:10;border-bottom:1px solid rgba(32,35,38,.14);color:var(--ink);background:rgba(251,248,242,.96);backdrop-filter:blur(16px)}.brand{height:104px;width:300px;margin-right:auto;display:grid;place-items:center;padding:.85rem 0;position:relative}.brand:after{content:'';position:absolute;inset:auto 0 0;height:3px;background:var(--copper);transform:scaleX(.28);transform-origin:left}.brand img{width:100%;height:auto;display:block}.site-header nav{display:flex;gap:clamp(1.2rem,2.5vw,2.6rem);margin:0 3rem}.site-header nav a,.header-cta{text-decoration:none;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase}.site-header nav a{opacity:.68}.site-header nav a:hover{opacity:1}.header-cta{border:1px solid rgba(32,35,38,.45);padding:.8rem 1rem}.header-cta span,.button span{margin-left:.8rem}.arrow-icon{display:inline-grid!important;place-items:center;width:1rem;height:1rem;flex:0 0 auto}.arrow-icon svg{display:block;width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.35;stroke-linecap:round;stroke-linejoin:round}.down-icon{display:inline-block;width:.65rem;height:.65rem;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;rotate:45deg;translate:0 -2px}.menu{display:none;background:none;border:0;color:var(--ink);width:40px;height:40px}.menu span:not(.sr-only){display:block;height:1px;background:currentColor;margin:7px}
  .hero{min-height:760px;height:100vh;max-height:980px;background:var(--ink);color:white;position:relative;display:flex;align-items:center;overflow:hidden;padding:9rem clamp(1.25rem,8vw,9rem) 5rem}.hero:after{content:'';position:absolute;inset:0;background:linear-gradient(120deg,transparent 48%,rgba(183,110,67,.035) 76%,transparent),linear-gradient(90deg,rgba(0,0,0,.18),transparent 50%);pointer-events:none}.hero-copy{position:relative;z-index:2;max-width:920px}.eyebrow{text-transform:uppercase;font-size:.72rem;letter-spacing:.18em;font-weight:600;color:var(--copper-dark);display:flex;align-items:center;gap:.7rem;margin:0 0 2rem}.eyebrow span{display:inline-block;width:30px;height:1px;background:currentColor}.eyebrow.light{color:#d9986f}.hero h1,.section-heading h2,.why h2,.approach h2,.contact h2,.story h2{font-family:var(--serif);font-weight:400;letter-spacing:-.035em;margin:0;line-height:.96;text-wrap:balance}.hero h1{font-size:clamp(3.4rem,7vw,7.6rem)}em{color:var(--copper);font-style:italic}.lede{font-size:clamp(.98rem,1.2vw,1.1rem);line-height:1.65;max-width:580px;color:rgba(255,255,255,.68);margin:2rem 0}.hero-actions{display:flex;gap:2rem;align-items:center}.button{display:inline-flex;align-items:center;justify-content:center;border:0;text-decoration:none;padding:1rem 1.35rem;font:600 .78rem var(--sans);letter-spacing:.06em;text-transform:uppercase;cursor:pointer}.copper{background:var(--copper);color:white}.copper:hover{background:var(--copper-dark)}.text-link{display:inline-flex;align-items:center;gap:.7rem;font-size:.82rem;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.35);padding:.7rem 0}.parallax{transform:translate3d(0,var(--drift,0),0);will-change:transform}.line-field{position:absolute;width:min(46vw,660px);height:70%;right:-3%;top:18%;opacity:.18}.line-field i{position:absolute;right:0;width:100%;height:1px;background:linear-gradient(90deg,transparent,rgba(217,152,111,.65),transparent);transform-origin:right;rotate:var(--r);top:var(--y)}.line-field i:nth-child(1){--y:18%;--r:-14deg}.line-field i:nth-child(2){--y:38%;--r:-5deg;width:82%}.line-field i:nth-child(3){--y:59%;--r:7deg;width:94%}.line-field i:nth-child(4){--y:78%;--r:16deg;width:70%}.line-field b{position:absolute;right:11%;bottom:0;font:clamp(8rem,17vw,18rem)/1 var(--serif);color:rgba(217,152,111,.19);letter-spacing:-.08em}.hero-note{position:absolute;right:5vw;bottom:15%;z-index:2;color:rgba(255,255,255,.6);font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}.hero-note .line{display:block;width:1px;height:70px;background:var(--copper);margin:0 0 1rem}.scroll{position:absolute;bottom:2rem;left:50%;z-index:2;text-transform:uppercase;letter-spacing:.15em;font-size:.6rem;opacity:.55}.scroll span{margin-left:1rem}
  .band{padding:clamp(5rem,9vw,9rem) clamp(1.25rem,8vw,9rem);display:grid;grid-template-columns:1fr 3fr;gap:3rem;background:var(--cream)}.section-tag{font-size:.7rem;text-transform:uppercase;letter-spacing:.18em;color:var(--copper-dark);margin:1rem 0}.statement{font:clamp(2rem,4vw,4.25rem)/1.16 var(--serif);margin:0;max-width:1000px;text-wrap:balance}.wrap{padding:clamp(5rem,9vw,9rem) clamp(1.25rem,8vw,9rem)}.section-heading{display:grid;grid-template-columns:1.5fr 1fr;gap:4rem;align-items:end;margin-bottom:5rem}.section-heading h2,.why h2,.approach h2,.contact h2{font-size:clamp(3.4rem,5.5vw,6rem)}.section-heading>p{color:#62645f;max-width:430px;margin:0 0 .5rem;font-size:.96rem;line-height:1.7}.service{display:grid;grid-template-columns:70px minmax(220px,1fr) 1.3fr 30px;gap:2rem;align-items:center;border-top:1px solid var(--line);padding:2rem 0}.service:last-child{border-bottom:1px solid var(--line)}.service>span,.service>i{color:var(--copper);font-size:.75rem}.service h3{font:400 clamp(1.65rem,2.3vw,2.5rem) var(--serif);margin:0}.service p{color:#686a65;margin:0;max-width:500px;font-size:.9rem}.service i{font-style:normal;font-size:1rem}
  .story{position:relative;overflow:hidden;padding:clamp(6rem,11vw,11rem) clamp(1.25rem,8vw,9rem);display:grid;grid-template-columns:.95fr 1.05fr;gap:clamp(4rem,9vw,10rem);background:var(--paper)}.story-title{position:relative;z-index:2}.story h2{font-size:clamp(3.5rem,5.7vw,6.3rem)}.family-portrait{position:relative;width:min(122%,760px);margin:4rem 0 -11rem -8%;isolation:isolate}.family-portrait:before{content:'';position:absolute;z-index:-2;left:5%;right:7%;bottom:5%;height:65%;background:linear-gradient(145deg,rgba(183,110,67,.16),rgba(225,218,204,.35));clip-path:polygon(8% 20%,100% 0,91% 100%,0 84%)}.family-portrait:after{content:'';position:absolute;z-index:-1;inset:16% -5% 4% 10%;border:1px solid rgba(183,110,67,.26);clip-path:polygon(7% 20%,100% 0,91% 100%,0 84%)}.family-portrait>span{position:absolute;z-index:-1;width:58%;height:1px;background:var(--copper);right:-5%;top:21%;rotate:-9deg;opacity:.5}.family-portrait img{display:block;width:100%;height:auto;filter:saturate(.84) contrast(.98);filter:drop-shadow(0 26px 34px rgba(32,35,38,.12)) saturate(.86)}.story-copy{position:relative;z-index:2;color:#5f615d;padding-top:2rem}.story-lead{font:clamp(1.3rem,1.8vw,1.75rem)/1.42 var(--serif);color:var(--ink);margin:0 0 2.5rem;max-width:620px}.story-columns{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;border-block:1px solid var(--line);padding:2rem 0;margin-bottom:1.4rem}.story-columns h3{font:2.1rem var(--serif);color:var(--copper-dark);margin:0 0 .65rem}.story-columns p{font-size:.88rem;line-height:1.75;margin:0}.story-signoff{font:1.3rem var(--serif);color:var(--ink);margin-top:1.7rem}.full-story{border-bottom:1px solid var(--line);padding:0 0 1rem}.full-story summary{list-style:none;cursor:pointer;color:var(--ink);text-transform:uppercase;letter-spacing:.12em;font-size:.69rem;font-weight:600;display:flex;justify-content:space-between;align-items:center;padding:.45rem 0}.full-story summary::-webkit-details-marker{display:none}.full-story>div{font-size:.88rem;line-height:1.75;max-width:650px;padding:.5rem 0}.plus{width:14px;height:14px;position:relative}.plus:before,.plus:after{content:'';position:absolute;background:var(--copper);inset:50% 0 auto;height:1px}.plus:after{rotate:90deg;transition:rotate .25s}.full-story[open] .plus:after{rotate:0deg}.story-lines{position:absolute;left:-4%;bottom:0;width:45%;height:55%;opacity:.08}.story-lines i{position:absolute;left:0;width:100%;height:1px;background:linear-gradient(90deg,transparent,var(--copper-dark),transparent);top:var(--y);rotate:var(--r)}.story-lines i:nth-child(1){--y:25%;--r:14deg}.story-lines i:nth-child(2){--y:50%;--r:-8deg}.story-lines i:nth-child(3){--y:72%;--r:20deg}
