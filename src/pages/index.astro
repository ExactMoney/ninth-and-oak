  .approach{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(4rem,8vw,9rem);background:var(--cream)}.approach-head{position:sticky;top:3rem;align-self:start}.approach-image{position:relative;margin:3.5rem 0 0;width:92%;height:clamp(210px,25vw,360px);overflow:hidden;isolation:isolate}.approach-image:after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent 38%,rgba(32,35,38,.34));z-index:1}.approach-image img{width:100%;height:100%;object-fit:cover;filter:saturate(.7) contrast(1.05)}.approach-image>span{position:absolute;z-index:2;left:-10%;top:22%;width:80%;height:1px;background:rgba(217,152,111,.75);rotate:-9deg}.approach-image figcaption{bottom:.7rem;right:.8rem}.approach ol{list-style:none;padding:0;margin:0}.approach li{display:grid;grid-template-columns:55px 1fr;gap:1.5rem;padding:2rem 0;border-top:1px solid var(--line)}.approach li:last-child{border-bottom:1px solid var(--line)}.approach li>span{color:var(--copper);font-size:.7rem}.approach h3{font:2rem var(--serif);margin:-.3rem 0 .5rem}.approach li p{color:#666862;margin:0}
