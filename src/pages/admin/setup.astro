---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Set up Ninth & Oak CRM" description="Create the initial Ninth & Oak CRM owner account." noindex={true}>
  <main>
    <section class="brand-panel"><div><span>9</span><i></i><p>NINTH <b>&amp;</b> OAK<small>PRIVATE BUSINESS OFFICE</small></p></div></section>
    <section class="setup-panel">
      <form id="setup-form">
        <p class="kicker">Initial owner setup</p>
        <h1>Create your secure access.</h1>
        <p class="intro">This registration is restricted to the approved Ninth & Oak owner address.</p>
        <label>Email<input name="email" type="email" value="Jason@NinthandOak.com" readonly /></label>
        <label>Password<input name="password" type="password" autocomplete="new-password" minlength="12" required /><small>Use at least 12 characters.</small></label>
        <label>Confirm password<input name="confirm" type="password" autocomplete="new-password" minlength="12" required /></label>
        <p id="message" role="status"></p>
        <button type="submit">Create owner account <span>↗</span></button>
        <a href="/admin">Return to sign in</a>
      </form>
    </section>
  </main>
  <script>
    import { createClient } from '@supabase/supabase-js';
    const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY);
    const form = document.querySelector('#setup-form');
    const message = document.querySelector('#message');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const target = event.currentTarget as HTMLFormElement;
      const data = new FormData(target);
      const password = String(data.get('password') || '');
      if (password !== String(data.get('confirm') || '')) { message.textContent = 'The passwords do not match.'; return; }
      message.textContent = 'Creating secure access…';
      const { data: result, error } = await supabase.auth.signUp({
        email: 'jason@ninthandoak.com',
        password,
        options: { emailRedirectTo: `${location.origin}/admin` }
      });
      if (error) { message.textContent = error.message; return; }
      target.reset();
      if (result.session) { location.href = '/admin'; return; }
      message.classList.add('success');
      message.textContent = 'Owner account created. Return here after the mailbox is connected to complete email verification.';
    });
  </script>
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap');
  :root{--ink:#202326;--copper:#b76e43;--paper:#fbf8f2;--serif:'Libre Caslon Display',Georgia,serif;--sans:'DM Sans',Arial,sans-serif}*{box-sizing:border-box}body{margin:0;font-family:var(--sans);color:var(--ink);background:var(--paper)}main{min-height:100vh;display:grid;grid-template-columns:58% 42%}.brand-panel{background:radial-gradient(circle at 42% 45%,#303536,#202326 58%);color:#f4efe6;display:grid;place-items:center}.brand-panel>div{display:flex;align-items:center}.brand-panel span{font:11rem/.7 var(--serif)}.brand-panel i{height:110px;width:1px;background:var(--copper);margin:0 2rem}.brand-panel p{font:2.5rem var(--serif);letter-spacing:.04em}.brand-panel b{color:var(--copper);font-weight:400}.brand-panel small{display:block;font:600 .58rem var(--sans);letter-spacing:.22em;color:#bcae9f;margin-top:.65rem}.setup-panel{display:grid;place-items:center;padding:3rem}.setup-panel form{width:min(100%,580px)}.kicker{text-transform:uppercase;letter-spacing:.17em;font-size:.64rem;font-weight:600;color:var(--copper)}h1{font:4rem/1 var(--serif);margin:.8rem 0 1.3rem}.intro{color:#72736e;margin-bottom:2.5rem}label{display:grid;gap:.5rem;text-transform:uppercase;letter-spacing:.09em;font-size:.65rem;font-weight:600;margin-bottom:1.25rem}label small{color:#898a84;text-transform:none;letter-spacing:0;font-weight:400}input{border:0;border-bottom:1px solid #bdb9b0;background:transparent;padding:.75rem 0;border-radius:0;font:1rem var(--sans)}input:focus{outline:2px solid var(--copper);outline-offset:4px}button{width:100%;border:0;background:var(--copper);color:white;padding:1rem 1.3rem;text-transform:uppercase;letter-spacing:.08em;font-size:.7rem;font-weight:600;cursor:pointer;margin-top:.5rem}button span{float:right}form>a{display:block;text-align:center;color:#777;font-size:.7rem;margin-top:1.5rem}#message{min-height:1.5rem;color:#9b4530;font-size:.78rem}.success{color:#416044!important}@media(max-width:850px){main{grid-template-columns:1fr}.brand-panel{display:none}.setup-panel{padding:3rem 1.25rem}h1{font-size:3.2rem}}
</style>
