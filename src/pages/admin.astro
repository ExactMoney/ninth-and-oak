---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Ninth & Oak CRM" description="Private Ninth & Oak business management workspace." noindex={true}>
  <main class="crm-shell">
    <section class="login-screen" id="login-screen">
      <div class="login-brand"><span>9</span><i></i><div>NINTH <b>&amp;</b> OAK<small>PRIVATE BUSINESS OFFICE</small></div></div>
      <form id="login-form" class="login-card">
        <p class="kicker">Authorized access only</p>
        <h1>Welcome back.</h1>
        <p>Sign in to manage relationships, opportunities, and the work ahead.</p>
        <label>Email<input name="email" type="email" autocomplete="email" required /></label>
        <label>Password<input name="password" type="password" autocomplete="current-password" required /></label>
        <p class="form-message" id="login-message" role="status"></p>
        <button type="submit">Sign in <span>↗</span></button>
        <a href="/">Return to website</a>
      </form>
    </section>

    <section class="app" id="crm-app" hidden>
      <aside>
        <a class="office-mark" href="/" aria-label="Ninth and Oak website"><span>9</span><div>NINTH <b>&amp;</b> OAK<small>BUSINESS OFFICE</small></div></a>
        <nav aria-label="CRM navigation">
          <button class="nav-link active" data-view="overview">Overview</button>
          <button class="nav-link" data-view="contacts">Contacts <span id="contact-count">0</span></button>
          <button class="nav-link" data-view="pipeline">Pipeline</button>
          <button class="nav-link" data-view="tasks">Tasks</button>
          <button class="nav-link" data-view="email">Email</button>
        </nav>
        <div class="aside-foot"><small id="user-email"></small><button id="sign-out">Sign out</button></div>
      </aside>

      <div class="workspace">
        <header><button class="mobile-nav" id="mobile-nav" aria-label="Toggle navigation">Menu</button><div><p class="kicker">Ninth & Oak / CRM</p><h1 id="view-title">Business overview</h1></div><button class="primary" id="new-contact">+ New contact</button></header>

        <div class="view active" data-panel="overview">
          <section class="metrics">
            <article><p>Open pipeline</p><strong id="pipeline-value">$0</strong><small id="open-deals">0 active opportunities</small></article>
            <article><p>Relationships</p><strong id="relationship-count">0</strong><small>leads, prospects & clients</small></article>
            <article><p>Tasks due</p><strong id="task-count">0</strong><small>open priorities</small></article>
          </section>
          <section class="overview-grid">
            <article class="panel"><div class="panel-head"><div><p class="kicker">Pipeline</p><h2>Where opportunity stands</h2></div><button data-jump="pipeline">View pipeline</button></div><div class="stage-bars" id="stage-bars"></div></article>
            <article class="panel"><div class="panel-head"><div><p class="kicker">Next up</p><h2>Priorities</h2></div><button data-jump="tasks">All tasks</button></div><div id="priority-list" class="priority-list"></div></article>
          </section>
          <section class="panel"><div class="panel-head"><div><p class="kicker">Relationships</p><h2>Recently added</h2></div><button data-jump="contacts">View contacts</button></div><div class="table-wrap"><table><thead><tr><th>Name</th><th>Company</th><th>Status</th><th>Source</th></tr></thead><tbody id="recent-contacts"></tbody></table></div></section>
        </div>

        <div class="view" data-panel="contacts">
          <section class="panel"><div class="toolbar"><input id="contact-search" type="search" placeholder="Search people or companies" /><select id="contact-filter"><option value="">All relationships</option><option value="lead">Leads</option><option value="prospect">Prospects</option><option value="client">Clients</option><option value="past_client">Past clients</option></select></div><div class="table-wrap"><table><thead><tr><th>Name</th><th>Company</th><th>Email</th><th>Status</th><th>Added</th></tr></thead><tbody id="contacts-table"></tbody></table></div></section>
        </div>

        <div class="view" data-panel="pipeline"><div class="kanban" id="kanban"></div></div>
        <div class="view" data-panel="tasks"><section class="panel"><div class="panel-head"><div><p class="kicker">Execution</p><h2>Open tasks</h2></div><button id="new-task">+ Add task</button></div><div id="tasks-list" class="tasks-list"></div></section></div>
        <div class="view" data-panel="email"><section class="email-empty"><span>↗</span><p class="kicker">CRM Email</p><h2>One place for every conversation.</h2><p>The inbox and composer are ready for the Resend connection. Once DNS and an API key are configured, sent messages and replies will automatically attach to the right contact.</p><button disabled>Compose email — setup required</button></section></div>
      </div>
    </section>

    <dialog id="contact-dialog"><form method="dialog" id="contact-form"><div class="dialog-head"><div><p class="kicker">New relationship</p><h2>Add a contact</h2></div><button value="cancel" aria-label="Close">×</button></div><div class="form-grid"><label>First name<input name="first_name" required /></label><label>Last name<input name="last_name" /></label><label>Email<input name="email" type="email" /></label><label>Phone<input name="phone" type="tel" /></label><label>Company<input name="company" /></label><label>Status<select name="status"><option value="lead">Lead</option><option value="prospect">Prospect</option><option value="client">Client</option><option value="past_client">Past client</option></select></label><label class="full">Notes<textarea name="notes" rows="4"></textarea></label></div><p class="form-message" id="contact-message"></p><div class="dialog-actions"><button value="cancel">Cancel</button><button class="primary" value="default" id="save-contact">Save contact</button></div></form></dialog>
    <dialog id="task-dialog"><form method="dialog" id="task-form"><div class="dialog-head"><div><p class="kicker">Next action</p><h2>Add a task</h2></div><button value="cancel" aria-label="Close">×</button></div><label>Task<input name="title" required /></label><label>Due date<input name="due_at" type="date" /></label><label>Priority<select name="priority"><option value="normal">Normal</option><option value="high">High</option><option value="low">Low</option></select></label><p class="form-message" id="task-message"></p><div class="dialog-actions"><button value="cancel">Cancel</button><button class="primary" value="default" id="save-task">Save task</button></div></form></dialog>
  </main>

  <script>
    import { createClient } from '@supabase/supabase-js';
    const url = import.meta.env.PUBLIC_SUPABASE_URL;
    const key = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
    const supabase = url && key ? createClient(url, key) : null;
    const $ = (s) => document.querySelector(s);
    const $$ = (s) => [...document.querySelectorAll(s)];
    const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
    const state = { contacts: [], deals: [], tasks: [] };
    const esc = (v='') => String(v).replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
    const nice = (v='') => v.replaceAll('_',' ').replace(/\b\w/g, c => c.toUpperCase());

    async function boot() {
      if (!supabase) { $('#login-message').textContent = 'CRM environment is not configured.'; return; }
      const { data } = await supabase.auth.getSession();
      if (data.session) await enter(data.session.user); else $('#login-screen').hidden = false;
    }
    async function enter(user) {
      $('#login-screen').hidden = true; $('#crm-app').hidden = false; $('#user-email').textContent = user.email || '';
      const [{data: contacts, error: ce}, {data: deals, error: de}, {data: tasks, error: te}] = await Promise.all([
        supabase.from('contacts').select('*').order('created_at',{ascending:false}),
        supabase.from('deals').select('*,contacts(first_name,last_name,company)').order('created_at',{ascending:false}),
        supabase.from('tasks').select('*').neq('status','cancelled').order('due_at',{ascending:true,nullsFirst:false})
      ]);
      if (ce || de || te) { $('#crm-app').hidden = true; $('#login-screen').hidden = false; $('#login-message').textContent = 'Your account is signed in but has not been granted CRM access.'; return; }
      state.contacts = contacts || []; state.deals = deals || []; state.tasks = tasks || []; render();
    }
    function render() {
      const open = state.deals.filter(d => !['won','lost'].includes(d.stage));
      $('#pipeline-value').textContent = money.format(open.reduce((s,d)=>s+Number(d.value),0));
      $('#open-deals').textContent = `${open.length} active ${open.length===1?'opportunity':'opportunities'}`;
      $('#relationship-count').textContent = state.contacts.length; $('#contact-count').textContent = state.contacts.length;
      $('#task-count').textContent = state.tasks.filter(t=>!['done','cancelled'].includes(t.status)).length;
      renderContacts(); renderPipeline(); renderTasks();
    }
    function contactRow(c) { return `<tr><td><strong>${esc(c.first_name)} ${esc(c.last_name)}</strong></td><td>${esc(c.company || '—')}</td><td>${esc(c.email || '—')}</td><td><span class="status ${esc(c.status)}">${nice(c.status)}</span></td><td>${new Date(c.created_at).toLocaleDateString()}</td></tr>`; }
    function renderContacts() {
      const q = ($('#contact-search')?.value || '').toLowerCase(), f = $('#contact-filter')?.value || '';
      const rows = state.contacts.filter(c => (!f || c.status===f) && (!q || `${c.first_name} ${c.last_name} ${c.company} ${c.email}`.toLowerCase().includes(q)));
      $('#contacts-table').innerHTML = rows.length ? rows.map(contactRow).join('') : '<tr><td colspan="5" class="empty">No matching contacts.</td></tr>';
      $('#recent-contacts').innerHTML = state.contacts.slice(0,5).map(c=>`<tr><td><strong>${esc(c.first_name)} ${esc(c.last_name)}</strong></td><td>${esc(c.company||'—')}</td><td><span class="status ${esc(c.status)}">${nice(c.status)}</span></td><td>${esc(nice(c.source))}</td></tr>`).join('') || '<tr><td colspan="4" class="empty">Your newest relationships will appear here.</td></tr>';
    }
    function renderPipeline() {
      const stages = ['new','discovery','proposal','negotiation','won'];
      $('#kanban').innerHTML = stages.map(stage => { const deals = state.deals.filter(d=>d.stage===stage); return `<section class="lane"><header><span>${nice(stage)}</span><b>${deals.length}</b></header><div>${deals.map(d=>`<article><small>${esc(d.contacts?.company || 'Opportunity')}</small><h3>${esc(d.name)}</h3><strong>${money.format(d.value)}</strong><p>${esc([d.contacts?.first_name,d.contacts?.last_name].filter(Boolean).join(' '))}</p></article>`).join('') || '<p class="lane-empty">No opportunities</p>'}</div></section>`; }).join('');
      const max = Math.max(1,...stages.map(s=>state.deals.filter(d=>d.stage===s).length));
      $('#stage-bars').innerHTML = stages.slice(0,4).map(s=>{const n=state.deals.filter(d=>d.stage===s).length;return `<div><span>${nice(s)}</span><i><b style="width:${n/max*100}%"></b></i><strong>${n}</strong></div>`}).join('');
    }
    function renderTasks() {
      const active = state.tasks.filter(t=>!['done','cancelled'].includes(t.status));
      const item = t => `<label class="task"><input type="checkbox" data-task="${t.id}" ${t.status==='done'?'checked':''}/><span><strong>${esc(t.title)}</strong><small>${t.due_at ? new Date(t.due_at).toLocaleDateString() : 'No due date'} · ${nice(t.priority)}</small></span></label>`;
      $('#tasks-list').innerHTML = active.length ? active.map(item).join('') : '<p class="empty">Nothing open. Add the next action when you’re ready.</p>';
      $('#priority-list').innerHTML = active.slice(0,5).map(item).join('') || '<p class="empty">No open priorities.</p>';
      $$('[data-task]').forEach(el=>el.addEventListener('change', async e=>{await supabase.from('tasks').update({status:e.target.checked?'done':'open'}).eq('id',e.target.dataset.task); const t=state.tasks.find(x=>x.id===e.target.dataset.task); if(t)t.status=e.target.checked?'done':'open'; render();}));
    }
    function showView(view) { $$('.view').forEach(v=>v.classList.toggle('active',v.dataset.panel===view)); $$('.nav-link').forEach(n=>n.classList.toggle('active',n.dataset.view===view)); $('#view-title').textContent = ({overview:'Business overview',contacts:'Relationships',pipeline:'Opportunity pipeline',tasks:'Tasks & follow-up',email:'Email center'})[view]; document.body.classList.remove('nav-open'); }
    $('#login-form').addEventListener('submit', async e=>{e.preventDefault(); const fd=new FormData(e.currentTarget); $('#login-message').textContent='Signing in…'; const {data,error}=await supabase.auth.signInWithPassword({email:String(fd.get('email')||''),password:String(fd.get('password')||'')}); if(error){$('#login-message').textContent=error.message;return;} await enter(data.user);});
    $('#sign-out').addEventListener('click',async()=>{await supabase.auth.signOut();location.reload();});
    $$('.nav-link').forEach(b=>b.addEventListener('click',()=>showView(b.dataset.view))); $$('[data-jump]').forEach(b=>b.addEventListener('click',()=>showView(b.dataset.jump)));
    $('#mobile-nav').addEventListener('click',()=>document.body.classList.toggle('nav-open')); $('#contact-search').addEventListener('input',renderContacts); $('#contact-filter').addEventListener('change',renderContacts);
    $('#new-contact').addEventListener('click',()=>$('#contact-dialog').showModal()); $('#new-task').addEventListener('click',()=>$('#task-dialog').showModal());
    $('#contact-form').addEventListener('submit',async e=>{e.preventDefault();const fd=new FormData(e.currentTarget);const payload=Object.fromEntries(fd);payload.source='manual';const {data,error}=await supabase.from('contacts').insert(payload).select().single();if(error){$('#contact-message').textContent=error.message;return;}state.contacts.unshift(data);e.currentTarget.reset();$('#contact-dialog').close();render();});
    $('#task-form').addEventListener('submit',async e=>{e.preventDefault();const fd=new FormData(e.currentTarget);const payload=Object.fromEntries(fd);if(!payload.due_at)delete payload.due_at;const {data,error}=await supabase.from('tasks').insert(payload).select().single();if(error){$('#task-message').textContent=error.message;return;}state.tasks.unshift(data);e.currentTarget.reset();$('#task-dialog').close();render();});
    boot();
  </script>
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap');
  :root{--ink:#202326;--copper:#b76e43;--paper:#fbf8f2;--cream:#f4efe6;--line:rgba(32,35,38,.14);--serif:'Libre Caslon Display',Georgia,serif;--sans:'DM Sans',Arial,sans-serif}*{box-sizing:border-box}body{margin:0;background:#ece9e2;color:var(--ink);font:15px/1.5 var(--sans)}button,input,select,textarea{font:inherit}button{cursor:pointer}.crm-shell{min-height:100vh}.login-screen{min-height:100vh;display:grid;grid-template-columns:1fr minmax(420px,42%);background:var(--ink);color:white}.login-screen[hidden]{display:none}.login-brand{display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 40% 40%,#303536,transparent 55%);font:2.5rem var(--serif);letter-spacing:.04em}.login-brand>span{font-size:11rem;line-height:.7;color:var(--paper)}.login-brand>i{height:110px;width:1px;background:var(--copper);margin:0 2rem}.login-brand b,.office-mark b{color:var(--copper);font-weight:400}.login-brand small,.office-mark small{display:block;font:600 .58rem var(--sans);letter-spacing:.22em;color:#bcae9f;margin-top:.65rem}.login-card{background:var(--paper);color:var(--ink);padding:clamp(3rem,7vw,7rem);display:flex;flex-direction:column;justify-content:center}.kicker{text-transform:uppercase;letter-spacing:.17em;font-size:.64rem;font-weight:600;color:var(--copper);margin:0 0 1rem}.login-card h1{font:4rem/1 var(--serif);margin:0}.login-card>p:not(.kicker,.form-message){color:#72736e;margin:1.4rem 0 3rem}.login-card label,.form-grid label,#task-form>label{display:grid;gap:.5rem;text-transform:uppercase;letter-spacing:.09em;font-size:.65rem;font-weight:600;margin-bottom:1.25rem}.login-card input,.form-grid input,.form-grid select,.form-grid textarea,#task-form input,#task-form select{border:0;border-bottom:1px solid #bdb9b0;background:transparent;padding:.7rem 0;border-radius:0}.login-card button,.primary{border:0;background:var(--copper);color:white;padding:1rem 1.3rem;text-transform:uppercase;letter-spacing:.08em;font-size:.7rem;font-weight:600}.login-card button{margin-top:1rem}.login-card button span{float:right}.login-card>a{text-align:center;color:#777;font-size:.7rem;margin-top:1.5rem}.form-message{color:#9b4530;min-height:1.3rem;font-size:.75rem}.app{min-height:100vh;display:grid;grid-template-columns:260px 1fr}.app[hidden]{display:none}aside{position:fixed;inset:0 auto 0 0;width:260px;background:#181b1c;color:white;padding:2rem 1.4rem;display:flex;flex-direction:column;z-index:5}.office-mark{display:flex;align-items:center;color:white;text-decoration:none;font:1.3rem var(--serif);padding:0 .5rem 2rem;border-bottom:1px solid rgba(255,255,255,.12)}.office-mark>span{font-size:4rem;line-height:.7;margin-right:1rem}.office-mark small{font-size:.48rem;margin-top:.3rem}.app aside nav{display:grid;gap:.25rem;margin:2.5rem 0}.nav-link{border:0;background:transparent;color:rgba(255,255,255,.57);text-align:left;padding:.85rem 1rem;border-radius:2px;display:flex;justify-content:space-between}.nav-link.active,.nav-link:hover{background:rgba(255,255,255,.08);color:white}.nav-link span{color:#d99569}.aside-foot{margin-top:auto;display:grid;gap:.8rem;padding:.8rem}.aside-foot small{color:rgba(255,255,255,.45);overflow:hidden;text-overflow:ellipsis}.aside-foot button{border:0;background:none;color:#d99569;text-align:left;padding:0}.workspace{grid-column:2;padding:0 clamp(1.25rem,4vw,4rem) 4rem}.workspace>header{height:130px;display:flex;align-items:center;justify-content:space-between;gap:2rem}.workspace>header h1{font:2.7rem/1 var(--serif);margin:0}.workspace>header .kicker{margin-bottom:.5rem}.mobile-nav{display:none}.view{display:none}.view.active{display:block}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:1rem}.metrics article,.panel{background:var(--paper);border:1px solid rgba(32,35,38,.08)}.metrics article{padding:1.7rem}.metrics p{margin:0 0 1rem;color:#74766f;font-size:.75rem;text-transform:uppercase;letter-spacing:.08em}.metrics strong{display:block;font:3rem/1 var(--serif)}.metrics small{color:#8b8c86}.overview-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:1rem;margin-bottom:1rem}.panel{padding:1.8rem}.panel-head,.toolbar{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.8rem}.panel h2,.email-empty h2,dialog h2{font:2rem/1.1 var(--serif);margin:0}.panel-head button{border:0;background:none;color:var(--copper);font-size:.7rem;text-transform:uppercase;letter-spacing:.08em}.stage-bars{display:grid;gap:1rem}.stage-bars>div{display:grid;grid-template-columns:90px 1fr 22px;gap:1rem;align-items:center;font-size:.72rem}.stage-bars i{height:8px;background:#e7e2d9}.stage-bars i b{display:block;height:100%;background:var(--copper)}.priority-list,.tasks-list{display:grid}.task{display:flex;gap:.8rem;align-items:flex-start;border-top:1px solid var(--line);padding:1rem 0}.task input{accent-color:var(--copper);margin-top:.2rem}.task span{display:grid}.task small{color:#85867f}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;text-align:left}th{font-size:.63rem;text-transform:uppercase;letter-spacing:.1em;color:#85867f;padding:.8rem}td{border-top:1px solid var(--line);padding:1rem .8rem;white-space:nowrap}.status{display:inline-block;padding:.2rem .55rem;background:#e8e3da;border-radius:20px;font-size:.65rem;text-transform:uppercase;letter-spacing:.06em}.status.client{background:#dfe7dc;color:#466044}.status.prospect{background:#f0dfd4;color:#8b4c2c}.toolbar input,.toolbar select{background:white;border:1px solid var(--line);padding:.75rem 1rem}.toolbar input{min-width:280px}.empty{color:#92938d;text-align:center;padding:2rem!important}.kanban{display:grid;grid-template-columns:repeat(5,minmax(230px,1fr));gap:1rem;overflow:auto;padding-bottom:1rem}.lane{background:#e3dfd7;min-height:560px}.lane>header{padding:1rem;display:flex;justify-content:space-between;text-transform:uppercase;font-size:.66rem;letter-spacing:.1em}.lane>header b{color:var(--copper)}.lane>div{padding:.35rem}.lane article{background:var(--paper);padding:1.1rem;margin-bottom:.5rem;border-top:2px solid var(--copper)}.lane article small,.lane article p{color:#777974}.lane article h3{font:1.25rem var(--serif);margin:.35rem 0}.lane article strong{font-weight:500}.lane article p{margin:.7rem 0 0;font-size:.75rem}.lane-empty{text-align:center;color:#999;font-size:.75rem;margin:2rem}.email-empty{min-height:620px;background:var(--ink);color:white;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:3rem}.email-empty>span{font:7rem var(--serif);color:var(--copper)}.email-empty h2{font-size:4rem;max-width:760px}.email-empty>p:not(.kicker){max-width:650px;color:rgba(255,255,255,.58)}.email-empty button{margin-top:1.5rem;padding:1rem 1.3rem;background:transparent;border:1px solid rgba(255,255,255,.25);color:rgba(255,255,255,.5)}dialog{border:0;padding:0;width:min(680px,calc(100% - 2rem));background:var(--paper);box-shadow:0 25px 80px rgba(0,0,0,.35)}dialog::backdrop{background:rgba(21,23,24,.72)}dialog form{padding:2rem}.dialog-head{display:flex;justify-content:space-between;margin-bottom:2rem}.dialog-head>button{border:0;background:none;font-size:2rem}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 1.5rem}.form-grid .full{grid-column:1/-1}.dialog-actions{display:flex;justify-content:flex-end;gap:.7rem;margin-top:1.2rem}.dialog-actions button{border:0;padding:.8rem 1rem}.dialog-actions .primary{background:var(--copper)}
  @media(max-width:850px){.login-screen{grid-template-columns:1fr}.login-brand{display:none}.app{display:block}.app aside{transform:translateX(-100%);transition:transform .25s}.nav-open .app aside{transform:none}.workspace{grid-column:auto;padding:0 1rem 3rem}.workspace>header{height:110px}.workspace>header h1{font-size:2rem}.mobile-nav{display:block;border:0;background:none;color:var(--copper)}.metrics{grid-template-columns:1fr}.overview-grid{grid-template-columns:1fr}.kanban{grid-template-columns:repeat(5,80vw)}.form-grid{grid-template-columns:1fr}.form-grid .full{grid-column:auto}.email-empty h2{font-size:2.7rem}}
  @media(max-width:520px){.workspace>header .primary{padding:.7rem;font-size:.6rem}.toolbar{align-items:stretch;flex-direction:column}.toolbar input{min-width:0}.panel{padding:1.15rem}.login-card{padding:2rem 1.25rem}.login-card h1{font-size:3.2rem}}
</style>
