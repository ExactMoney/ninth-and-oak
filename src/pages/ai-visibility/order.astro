---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Your Ninth & Oak order" description="Secure access to your AI Visibility materials." noindex>
  <main><a class="brand" href="/">NINTH <span>&amp;</span> OAK</a><section><p class="eyebrow">Order confirmation</p><h1>Your Ninth & Oak order is in.</h1><p>Look for your access email at the address you used at checkout. If payment is still processing, we’ll send access once it clears.</p><div id="status" role="status">Verifying your payment securely…</div><div id="downloads" hidden></div><div id="upsell" hidden><hr><h2>Want Ninth & Oak to do the work for you?</h2><h3>AI Visibility Management · $250/month</h3><p>We’ll establish a baseline for one business and one priority market, then monitor two agreed AI search experiences. Each month we’ll review what changed, complete one agreed website page or business profile update where your access allows, and send a plain-language report with the next priority.</p><p><strong>$250 USD today, then $250 USD each month until canceled.</strong> You can cancel future renewals through the billing portal. We’ll confirm your priority market, access and first update during onboarding. AI recommendations and lead volume vary.</p><a class="button" href="https://buy.stripe.com/cNi3cw96B9qb0bFgxZgMw03">Start monthly management — $250/month</a><a class="continue" href="#downloads">Continue with my materials</a></div></section></main>
  <script>
    const params = new URLSearchParams(location.search); const id = params.get('session_id'); const status = document.querySelector('#status'); const downloads = document.querySelector<HTMLDivElement>('#downloads'); const upsell = document.querySelector<HTMLDivElement>('#upsell');
    async function check(attempt=0){ if(!id){status!.textContent='This access link is incomplete. Use the link from your receipt email.';return;} try{const r=await fetch(`/api/ai-visibility-status?session_id=${encodeURIComponent(id)}`,{cache:'no-store'});const data=await r.json();if(data.paid){status!.textContent=`Payment confirmed — ${data.offerName}.`;downloads!.hidden=false;downloads!.innerHTML=data.files.length?`<h2>Your private downloads</h2>${data.files.map((f:any)=>`<a class="button" href="${f.url}">${f.file==='playbook'?'Download the Playbook PDF':'Download the editable Toolkit ZIP'}</a>`).join('')}`:`<h2>Payment confirmed</h2><a class="button" href="${data.onboardingUrl}">Continue to onboarding</a>`;if(data.offer!=='management')upsell!.hidden=false;return;}if(attempt<10){status!.textContent='Your payment is still processing. We’ll check again automatically…';setTimeout(()=>check(attempt+1),3000);return;}status!.textContent='Payment is still processing. We’ll email your access as soon as Stripe confirms it.';}catch{status!.textContent='We could not verify the order yet. Refresh this page or use the access link in your email.';}}check();
  </script>
</Layout>
<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600&family=Libre+Caslon+Display:ital@0;1&display=swap');:global(*){box-sizing:border-box}:global(body){margin:0;background:#123f35;color:#f8f2e8;font:16px/1.65 'DM Sans',sans-serif}main{min-height:100vh;padding:clamp(2rem,7vw,6rem)}.brand{font:1.4rem 'Libre Caslon Display',serif;letter-spacing:.08em;text-decoration:none}.brand span,.eyebrow{color:#c99552}section{max-width:820px;margin:8vh auto;background:#fbf7ef;color:#173f35;padding:clamp(2rem,6vw,5rem);border-top:5px solid #b66f3f}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:.68rem;font-weight:600}h1,h2,h3{font:400 'Libre Caslon Display',serif}h1{font-size:clamp(3rem,7vw,5.7rem);line-height:1;margin:1rem 0 1.5rem}h2{font-size:2.3rem}h3{font-size:1.6rem}#status{padding:1rem;border:1px solid #cdbf9f;margin:2rem 0}.button{display:inline-block;background:#b66f3f;color:white;text-decoration:none;text-transform:uppercase;letter-spacing:.07em;font-size:.7rem;font-weight:600;padding:1rem 1.25rem;margin:.4rem .5rem .4rem 0}.continue{display:block;margin-top:1rem;font-weight:600}hr{border:0;border-top:1px solid #cdbf9f;margin:3rem 0}
</style>
