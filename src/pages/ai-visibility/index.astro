---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="AI Visibility Playbook | Ninth & Oak" description="A practical 30-day process to find out whether AI search recommends your business and improve what buyers can verify.">
  <header><a class="brand" href="/">NINTH <span>&amp;</span> OAK</a><a href="/">Back to Ninth & Oak</a></header>
  <main>
    <section class="hero">
      <p class="eyebrow">A practical guide for small businesses</p>
      <h1>Find out whether AI search <em>recommends your business.</em></h1>
      <p class="lede">When someone asks ChatGPT, Claude or Google for a business like yours, what shows up? The Ninth & Oak AI Visibility Playbook gives you a 30-day process for checking what buyers see, correcting inaccurate information and making your services easier to find and verify.</p>
      <a class="button" href="#offers">Choose your materials</a>
    </section>
    <section class="method">
      <p class="eyebrow">Clear, repeatable progress</p>
      <h2>Start with one service and one market.</h2>
      <p>Run a baseline, improve one key page and repeat the same tests. You’ll know what you changed and what the next round actually showed.</p>
      <div class="steps"><article><b>01</b><h3>See what buyers see</h3><p>Use 32 prompts across agreed AI search experiences and save your baseline.</p></article><article><b>02</b><h3>Correct the record</h3><p>Build a reliable business identity and improve the page that matters most.</p></article><article><b>03</b><h3>Measure the change</h3><p>Repeat the same tests at 30, 60 and 90 days with a documented scorecard.</p></article></div>
    </section>
    <section id="offers" class="offers">
      <div class="section-title"><p class="eyebrow">Choose your starting point</p><h2>Practical materials. <em>Immediate access after verified payment.</em></h2></div>
      <article class="offer">
        <div><p class="number">01</p><h3>AI Visibility Playbook</h3><p class="price">$27 <span>USD once</span></p></div>
        <ul><li>Complete 2026–2027 PDF</li><li>Printable worksheets</li><li>32 ready-to-run prompts</li><li>A focused 30-day plan</li></ul>
        <a class="button pending" aria-disabled="true" href="#launch-status">Get the Playbook — $27</a>
      </article>
      <article class="offer featured">
        <div><p class="number">02 · Best value</p><h3>AI Visibility Business Toolkit</h3><p class="price">$47 <span>USD once</span></p></div>
        <ul><li>Everything in the Playbook</li><li>Editable trial and run logs</li><li>Business identity and competitor trackers</li><li>Scorecard and performance templates</li></ul>
        <a class="button pending" aria-disabled="true" href="#launch-status">Get the Business Toolkit — $47</a>
      </article>
      <p id="launch-status" class="launch-status">Secure checkout is being connected and verified. Purchase access will open after fulfillment testing is complete.</p>
    </section>
    <section class="faq"><p class="eyebrow">Straight answers</p><details open><summary>Can I do this without a developer?</summary><p>Yes. Start with public search tests and the business identity worksheet. You may need your website owner’s help with access or technical changes.</p></details><details><summary>Will this guarantee recommendations?</summary><p>No. Search results vary by platform, location, timing and question. The guide teaches a repeatable way to measure what you observe.</p></details><details><summary>How do I receive my files?</summary><p>After Stripe confirms payment, your private download buttons appear immediately. We also send an access link to the email used at checkout.</p></details></section>
  </main>
  <footer><p>Ninth & Oak. <em>Rooted in Experience. Built for What’s Next.</em></p><a href="mailto:hello@ninthandoak.com">hello@ninthandoak.com</a></footer>
</Layout>
<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display:ital@0;1&display=swap');
  :global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){margin:0;background:#f7f1e7;color:#173f35;font:16px/1.65 'DM Sans',Arial,sans-serif}:global(a){color:inherit}header{height:88px;padding:0 clamp(1.2rem,6vw,6rem);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #cabd9d;background:#fbf7ef}header>a:last-child{font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;text-decoration:none}.brand{font:1.5rem 'Libre Caslon Display',Georgia,serif;letter-spacing:.08em;text-decoration:none}.brand span,em,.number{color:#b66f3f}.hero{min-height:74vh;display:flex;flex-direction:column;justify-content:center;padding:clamp(5rem,10vw,10rem) clamp(1.2rem,10vw,10rem);background:#123f35;color:#fff;position:relative;overflow:hidden}.hero:after{content:'';position:absolute;width:45vw;height:45vw;border:1px solid rgba(203,158,87,.22);border-radius:50%;right:-14vw;top:-18vw;box-shadow:0 0 0 36px rgba(203,158,87,.07),0 0 0 72px rgba(203,158,87,.05)}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:.68rem;font-weight:600;color:#c99552}.hero h1,.section-title h2,.method h2{font:400 clamp(3.4rem,7vw,7.5rem)/.96 'Libre Caslon Display',Georgia,serif;letter-spacing:-.035em;max-width:1050px;margin:1.2rem 0 1.8rem}.hero em,.section-title em{font-weight:400}.lede{max-width:760px;color:rgba(255,255,255,.74);font-size:1.1rem}.button{align-self:flex-start;background:#b66f3f;color:white;text-decoration:none;text-transform:uppercase;letter-spacing:.08em;font-size:.72rem;font-weight:600;padding:1rem 1.35rem;margin-top:1.4rem}.method,.offers,.faq{padding:clamp(5rem,9vw,9rem) clamp(1.2rem,8vw,8rem)}.method h2,.section-title h2{font-size:clamp(2.8rem,5vw,5rem)}.method>p:not(.eyebrow){max-width:720px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#cdbf9f;margin-top:4rem}.steps article{background:#fbf7ef;padding:2rem}.steps h3,.offer h3{font:400 2rem/1.15 'Libre Caslon Display',Georgia,serif}.offers{background:#fbf7ef;display:grid;grid-template-columns:1fr 1fr;gap:1.25rem}.section-title{grid-column:1/-1;max-width:1000px;margin-bottom:2rem}.offer{border:1px solid #cdbf9f;padding:clamp(1.5rem,4vw,3.5rem);display:flex;flex-direction:column}.offer.featured{border-top:5px solid #b66f3f}.offer h3{font-size:clamp(2.2rem,4vw,3.7rem);margin:.5rem 0}.price{font:3.2rem 'Libre Caslon Display',Georgia,serif;margin:.5rem 0 1.5rem}.price span{font:500 .7rem 'DM Sans',Arial,sans-serif;text-transform:uppercase;letter-spacing:.12em}.offer ul{padding-left:1.2rem;min-height:150px}.offer .button{margin-top:auto}.faq{max-width:1100px;margin:auto}.faq details{border-top:1px solid #cdbf9f;padding:1.3rem 0}.faq summary{font:1.7rem 'Libre Caslon Display',Georgia,serif;cursor:pointer}.faq details p{max-width:760px;color:#536a63}footer{background:#161d1b;color:#eee7dc;padding:3rem clamp(1.2rem,6vw,6rem);display:flex;justify-content:space-between;gap:2rem}footer p{font:1.25rem 'Libre Caslon Display',Georgia,serif;margin:0}footer a{font-size:.8rem}@media(max-width:760px){.hero h1{font-size:clamp(3.2rem,15vw,5rem)}.steps,.offers{grid-template-columns:1fr}.section-title{grid-column:auto}.offer ul{min-height:auto}.offers{padding-inline:1rem}footer{flex-direction:column}.hero{min-height:auto}.button{width:100%;text-align:center}}
  .pending{opacity:.65;cursor:not-allowed}.launch-status{grid-column:1/-1;border-left:3px solid #b66f3f;padding:.75rem 1rem;background:#f3eadc;margin:.25rem 0 0}
</style>
