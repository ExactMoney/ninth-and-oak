---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="AI Visibility Management onboarding | Ninth & Oak" description="Begin your AI Visibility Management onboarding." noindex>
  <main><a href="/" class="brand">NINTH <span>&amp;</span> OAK</a><section><p class="eyebrow">Management onboarding</p><h1>Let’s establish your baseline.</h1><p id="status">Verifying your subscription payment…</p><div id="verified" hidden><p>Your first payment is confirmed. A Ninth & Oak team member will contact you at the checkout email to confirm your priority market, access, and first update.</p><a class="button" href="/business-profile">Complete your business profile</a></div></section></main>
  <script>const id=new URLSearchParams(location.search).get('session_id');const status=document.querySelector('#status');const verified=document.querySelector<HTMLDivElement>('#verified');if(id)fetch(`/api/ai-visibility-status?session_id=${encodeURIComponent(id)}`,{cache:'no-store'}).then(r=>r.json()).then(data=>{if(data.paid&&data.offer==='management'){status!.textContent='Payment confirmed.';verified!.hidden=false}else status!.textContent='A verified Management subscription is required to continue.'}).catch(()=>status!.textContent='We could not verify your subscription. Please use the link in your receipt email.');else status!.textContent='This onboarding link is incomplete.';</script>
</Layout>
<style>@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600&family=Libre+Caslon+Display:ital@0;1&display=swap');:global(*){box-sizing:border-box}:global(body){margin:0;background:#f7f1e7;color:#173f35;font:16px/1.65 'DM Sans',sans-serif}main{min-height:100vh;padding:clamp(2rem,7vw,6rem)}.brand{font:1.4rem 'Libre Caslon Display',serif;letter-spacing:.08em;text-decoration:none}.brand span,.eyebrow{color:#b66f3f}section{max-width:800px;margin:12vh auto}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:.68rem;font-weight:600}h1{font:400 clamp(3.3rem,8vw,6.5rem)/.95 'Libre Caslon Display',serif;margin:1rem 0 2rem}.button{display:inline-block;background:#b66f3f;color:white;text-decoration:none;padding:1rem 1.3rem;text-transform:uppercase;letter-spacing:.07em;font-size:.72rem;font-weight:600;margin-top:1rem}</style>
